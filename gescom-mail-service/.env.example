# Copia este archivo a .env y ajusta los valores. .env no se sube a git.

# RabbitMQ. Mismos nombres y valores por defecto que usa el back.
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=gescom_user_rabbit
RABBITMQ_PASSWORD=gescom_password_rabbit

# Remitente de los correos
MAIL_FROM=no-reply@gescom.local
MAIL_FROM_NAME=Gescom
MAIL_APP_NAME=Gescom

# Servidor SMTP. Por defecto, Mailpit (pruebas). Para uno real, cambia estos valores.
# Ejemplo con Gmail (cuenta dedicada con verificación en dos pasos y contraseña de aplicación):
#   SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_AUTH=true  SMTP_STARTTLS=true
#   SMTP_USER=gescom.proyecto@gmail.com  SMTP_PASSWORD=<contraseña de aplicación>
#   MAIL_FROM=gescom.proyecto@gmail.com   (Gmail firma con la cuenta con la que te identificas)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_AUTH=false
SMTP_STARTTLS=false
SMTP_USER=
SMTP_PASSWORD=
