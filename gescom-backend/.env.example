# Variables del back (todas opcionales). Copia este archivo a .env si usas Docker Compose; en IntelliJ se ponen
# en "Run > Edit Configurations > Environment variables".

# INTERRUPTOR DEL CORREO
#   false (por defecto): sin correo. El usuario que se registra queda validado y puede entrar.
#   true : el registro manda un mensaje a RabbitMQ y el microservicio envía el enlace de verificación.
MAIL_ENABLED=false
FRONT_URL=http://localhost:5173
MAIL_TOKEN_HOURS=24
CORS_ORIGINS=http://localhost:5173

# Solo si MAIL_ENABLED=true y quieres enviar correos de verdad (los lee el microservicio, no el back):
# Gmail: cuenta dedicada, verificación en dos pasos y "contraseña de aplicación" de 16 caracteres.
#SMTP_HOST=smtp.gmail.com
#SMTP_PORT=587
#SMTP_AUTH=true
#SMTP_STARTTLS=true
#SMTP_USER=gescom.proyecto@gmail.com
#SMTP_PASSWORD=la-contraseña-de-aplicación
#MAIL_FROM=gescom.proyecto@gmail.com
